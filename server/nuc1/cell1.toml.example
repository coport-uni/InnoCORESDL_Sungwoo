# NUC1 / Cell A -- pump + XZ gantry (X axis 1, Z axes 2 driven in sync).
# Copy to server/nuc1/cell1.toml (gitignored), then:
#   systemctl enable --now cell@nuc1-cell1
#   # or, by hand:  python -m server --config server/nuc1/cell1.toml

# Omit this whole table to run the cell as a gantry with no pump: every
# /v1/pump/* call then answers 409 ("configured without a pump") and
# diagnose() reports pump.present=false, instead of the cell failing to
# open at all. That is how cell1 runs while its SY-01B is off the bench.
[pump]
port = "1A86:7523"     # SY-01B CH340 USB-serial (VID:PID)
syringe_uL = 125
# Z<force> homing code, matched to the syringe: 0 = full force (>= 1 mL),
# 1 = half (250/500 uL), 2 = one-third (50-125 uL), 10..40 = S-code speed.
# This bench's 125 uL syringe takes 2 -- full force would slam the small
# barrel's top stop during homing.
init_force = 2

[stage]
# FTDI serial of the X adapter; the other two adapters are the paired Z,
# auto-assigned and always driven together (mks_motor move_sync).
# Run external/ESP32S3BOX3MotorController/CAN2USBAdapterDeviceRecognition.py
# to read the serials off the adapters actually plugged into this NUC.
serial_x = "NTAMU6TO"
z_coord_invert = true
x_coord_invert = true

[server]
host = "0.0.0.0"
port = 17054           # cell1 -- matches [cells.cell1] in the orchestrator
log_level = "info"
