# NUC2 / Cell B -- hardware clone of Cell A (spec section 2). No new cell
# class: the only difference from cell1 is this file.
# Copy to server/nuc2/cell2.toml (gitignored), then:
#   python -m server --config server/nuc2/cell2.toml
#   (or: systemctl enable --now cell@nuc2-cell2)

# NO [pump] TABLE ON PURPOSE. Neither gantry cell on NUC2 has a syringe
# pump on the bench, so /v1/pump/* answers 409 -- which is what the
# synthesis scenario asserts (`d2.pump.present == False`). Adding the
# table back makes the cell try to open a pump that is not there.

[stage]
# ALL THREE ADAPTERS ARE NAMED. NUC2 carries seven FTDI adapters across
# three cells; naming X alone lets the driver assign whichever two remain
# to Z, which picks up another cell's motors and makes serving cell2 and
# cell3 at once impossible. Serials read off NUC2's live bus 2026-07-29
# and cross-checked against the operator's wiring list -- the list's
# `NTAF1KQ` is really `NTAFT1KQ` (a dropped character), and `NTB3EP5R`
# belongs to cell5, not here.
serial_x = "NTB19XKA"
serial_z_a = "NTAFT1KQ"
serial_z_b = "NTA0X8KN"
z_coord_invert = true
x_coord_invert = true

[server]
host = "0.0.0.0"
port = 17056           # cell2 -- matches [cells.cell2] in the orchestrator
log_level = "info"
