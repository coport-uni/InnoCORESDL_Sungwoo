# NUC2 / Cell 5 -- pump + single Z stage + hotplate + IR lamp (Tapo plug)
# + fan (a second Tapo plug).
# Copy to server/nuc2/cell5.toml (gitignored), then:
#   systemctl enable --now cell@nuc2-cell5
#   # or, by hand:  python -m server --config server/nuc2/cell5.toml
#
# The [zstage]/[hotplate]/[lamp]/[fan] tables are what select this cell
# shape --
# no --cell flag needed.

# The [pump] table is OPTIONAL: omit it while the syringe pump is not on
# the bench yet and the cell serves Z + hotplate + lamp, answering 409 on
# the pump routes (like the absent balance). Add it back when the pump
# arrives.
[pump]
port = "1A86:7523"     # SY-01B CH340 USB-serial (VID:PID)
syringe_uL = 125
init_force = 2

[zstage]
# ONE MKS SERVO57D on an FTDI USB2CAN adapter. Unlike cell1-3 there is no
# X axis and no paired-Z group -- this is a single motor.
# Fill in this adapter's FTDI serial (udevadm info -q property -n
# /dev/ttyUSB0 | grep SERIAL_SHORT). Omitting it opens the first
# enumerated FTDI device, which is only safe if it is the only one here.
# The NUC2 bench adapter (NTREX USB2CAN) is NTB3EP5R.
serial = "NTB3EP5R"
coord_invert = true    # +mm moves away from the 0x00 home limit
home_dir = 0           # flip 0 <-> 1 to home off the opposite end

[hotplate]
# IKA RCT digital. Omit `port` to auto-detect by USB VID:PID
# (hotplate_controller.find_rct_port).
# port = "/dev/ttyUSB2"
#
# Cell-level ceiling on the setpoint, enforced before the driver is even
# called: an orchestrated run cannot ask for more than this. Set it to the
# lowest value the chemistry on this bench actually needs.
max_celsius = 150.0

[lamp]
# IR lamp, switched through a Tapo plug over the LAN (python-kasa).
# `target` is a device name or IP from external/SmartPlugController's
# device_list.md. "all" would switch every plug on the bench -- name the
# one plug instead.
# Credentials live in external/SmartPlugController/secure.env, written by
# the operator. If they are missing the cell still starts; only the lamp
# endpoints return 409.
# A bare IP that device_list.md does not know is also accepted -- the
# cell synthesises the entry, so a re-DHCPed plug needs no edit inside
# the submodule. The NUC2 bench plug (tapo_plug1) is 192.168.0.237.
target = "192.168.0.237"

[fan]
# Fan, switched through a SECOND Tapo plug (same driver, same
# secure.env credentials as the lamp). This table is OPTIONAL: omit it
# and the cell serves everything else, answering 409 on /v1/fan/*.
#
# `target` must name ONE plug, and not the lamp's -- the cell refuses to
# start on "all" or on the [lamp] target, because `fan/switch` would
# then light the IR lamp.
#
# The NUC2 bench fan plug is `plug2` (tapo p110m, MAC
# 18-69-45-71-02-7C), found at 192.168.0.77 on 2026-09-30. The driver's
# device_list.md still lists plug2 under a stale 192.168.1.79, so name
# the IP here, not "plug2": the cell synthesises the entry for a bare
# IP the list does not know (LearnedPatterns #29).
#
# /v1/stop switches the fan off together with the heater, the stirrer
# and the lamp. Unlike those, `fan/switch` is NOT gated by the
# orchestrator's first-motion confirmation.
target = "192.168.0.77"

[server]
host = "0.0.0.0"
port = 17062           # cell5 -- confirm against SDLClaude ARCHITECTURE.md
log_level = "info"
