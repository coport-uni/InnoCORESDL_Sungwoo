# NUC2 / Cell C -- hardware clone of Cell A (spec section 2). No new cell
# class: the only difference from cell1 is this file.
# Copy to server/nuc2/cell3.toml (gitignored), then:
#   python -m server --config server/nuc2/cell3.toml
#   (or: systemctl enable --now cell@nuc2-cell3)

# NO [pump] TABLE ON PURPOSE. Neither gantry cell on NUC2 has a syringe
# pump on the bench, so /v1/pump/* answers 409 -- which is what the
# synthesis scenario asserts (`d3.pump.present == False`). Adding the
# table back makes the cell try to open a pump that is not there.

[stage]
# ALL THREE ADAPTERS ARE NAMED -- see server/nuc2/cell2.toml.example for
# why. Serials read off NUC2's live bus 2026-07-29.
serial_x = "NTB3FXCE"
serial_z_a = "NTA4FH8Q"
serial_z_b = "NT9ZVXLU"
z_coord_invert = true
x_coord_invert = true

[server]
host = "0.0.0.0"
port = 17058           # cell3 -- matches [cells.cell3] in the orchestrator
log_level = "info"
